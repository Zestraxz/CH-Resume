# =============================================================================
# {{PROJECT_NAME}} — .gitattributes
# =============================================================================
# Normalize line endings across Windows / macOS / Linux.
# Mark generated and binary files explicitly.

# Default: text files are normalized to LF in the repo, native EOL in working tree
* text=auto eol=lf

# ---- Force LF (Unix) for shell, source, configs ----------------------------
*.sh    text eol=lf
*.bash  text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.scss  text eol=lf
*.sql   text eol=lf
Dockerfile text eol=lf

# ---- Force CRLF (Windows) for Windows-only scripts -------------------------
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# ---- Binary ----------------------------------------------------------------
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   text eol=lf
*.webp  binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.7z    binary
*.tar   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.mp3   binary
*.mp4   binary
*.mov   binary
*.webm  binary

# ---- Generated / vendored (GitHub linguist) --------------------------------
package-lock.json  linguist-generated=true -diff
pnpm-lock.yaml     linguist-generated=true -diff
poetry.lock        linguist-generated=true -diff
uv.lock            linguist-generated=true -diff
dist/**            linguist-generated=true
build/**           linguist-generated=true
coverage/**        linguist-generated=true
node_modules/**    linguist-vendored=true

# ---- Exclude from archives -------------------------------------------------
.github/        export-ignore
.gitignore      export-ignore
.gitattributes  export-ignore
.editorconfig   export-ignore
tests/          export-ignore
