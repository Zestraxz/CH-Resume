# Fly.io deployment template - https://fly.io/docs/reference/configuration/
# Copy to fly.toml at project root and customize.
# Deploy: flyctl deploy

app = "{{PROJECT_NAME_KEBAB}}"
primary_region = "sin"        # Singapore; pick yours via `flyctl platform regions`
kill_signal = "SIGINT"
kill_timeout = 5

[build]
  dockerfile = "apps/api/Dockerfile"
  build-target = "production"

[env]
  NODE_ENV = "production"
  PORT = "8000"

[http_service]
  internal_port = 8000
  force_https = true
  auto_stop_machines = "stop"
  auto_start_machines = true
  min_machines_running = 1
  processes = ["app"]

  [http_service.concurrency]
    type = "requests"
    soft_limit = 200
    hard_limit = 250

[[services.tcp_checks]]
  interval = "15s"
  timeout = "2s"
  grace_period = "10s"
  port = 8000

[[vm]]
  size = "shared-cpu-1x"
  memory = "512mb"
  cpu_kind = "shared"
  cpus = 1

# Secrets via: flyctl secrets set DATABASE_URL=... JWT_SECRET=...
