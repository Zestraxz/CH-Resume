# =============================================================================
# Resume — Environment variables (EXAMPLE)
# =============================================================================
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# CI/CD pulls from a secret manager — keep .env.example as the source of truth
# for variable names.

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
APP_NAME=Resume

# ---- Ports ------------------------------------------------------------------
WEB_PORT=3000
API_PORT=8000

# ---- Database ---------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=resume
POSTGRES_USER=resume_user
POSTGRES_PASSWORD=change-me-in-prod
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---- Cache / queue ----------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# ---- Auth / security --------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
SESSION_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- AI provider keys (optional; only if app uses them at runtime) ----------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# ---- Observability (OpenTelemetry standard env vars) -----------------------
SENTRY_DSN=
OTEL_SERVICE_NAME=resume
OTEL_RESOURCE_ATTRIBUTES=service.version=0.1.0,deployment.environment=development
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

# ---- AI cost guardrails (only if app uses LLMs at runtime) -----------------
# Hard daily cap across all providers; exceeding returns 429.
LLM_DAILY_BUDGET_USD=10
# Per-request max tokens (cheap circuit breaker).
LLM_MAX_TOKENS_PER_REQUEST=4096
# Alert threshold (percentage of daily budget consumed).
LLM_BUDGET_ALERT_PCT=80
# LiteLLM / Portkey proxy URL (if used). Otherwise unset.
LLM_PROXY_URL=

# ---- Feature flags ----------------------------------------------------------
FEATURE_FOO_ENABLED=false
